# name: test/sql/redis_secret_optional_password.test
# description: a redis secret without a password is found (connects without AUTH); "not found" means the secret is missing
# group: [redis]

require redis

# No password key at all. Port 1 is closed, so the lookup succeeds and the connection fails.
statement ok
CREATE SECRET redis_nopass (TYPE redis, host '127.0.0.1', port '1');

statement error
SELECT redis_get('mykey', 'redis_nopass');
----
Redis connection error

statement error
SELECT * FROM redis_keys('*', 'redis_nopass');
----
Redis connection error

# A secret that doesn't exist is still "not found"
statement error
SELECT redis_get('mykey', 'redis_does_not_exist');
----
Redis secret not found

# Missing required keys are reported as such, not as "not found"
statement ok
CREATE SECRET redis_nohost (TYPE redis, port '1');

statement error
SELECT redis_get('mykey', 'redis_nohost');
----
Redis secret 'redis_nohost' is missing required key 'host'

statement ok
CREATE SECRET redis_noport (TYPE redis, host '127.0.0.1');

statement error
SELECT redis_get('mykey', 'redis_noport');
----
Redis secret 'redis_noport' is missing required key 'port'
