# name: test/sql/redis_parameter_names.test
# description: duckdb_functions() reports the real parameter names, and calls stay positional
# group: [redis]

require redis

query TT
SELECT function_name, parameters FROM duckdb_functions()
WHERE function_name LIKE 'redis%' AND function_type IN ('scalar', 'table')
ORDER BY function_name;
----
redis_del	[key, secret_name]
redis_exists	[key, secret_name]
redis_expire	[key, seconds, secret_name]
redis_expireat	[key, timestamp, secret_name]
redis_get	[key, secret_name]
redis_hget	[key, field, secret_name]
redis_hgetall	[key, secret_name]
redis_hscan	[key, cursor, pattern, count, secret_name]
redis_hscan_over_scan	[scan_pattern, hscan_pattern, count, secret_name]
redis_hset	[key, field, value, secret_name]
redis_keys	[pattern, secret_name]
redis_lpush	[key, value, secret_name]
redis_lrange	[key, start, stop, secret_name]
redis_lrange_table	[key, start, stop, secret_name]
redis_mget	[keys, secret_name]
redis_scan	[cursor, pattern, count, secret_name]
redis_set	[key, value, secret_name]
redis_ttl	[key, secret_name]
redis_type	[key, secret_name]

# A positional call still binds (and then fails on the missing secret, as before)
statement error
SELECT redis_get('mykey', 'nonexistent_secret');
----
Redis secret not found
